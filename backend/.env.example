# Google Gemini API Key
# Get it from: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=<<PLACEHOLDER_FOR_API_KEY>>

# Environment
NODE_ENV=production

# Frontend URL for CORS
FRONTEND_URL=https://krushnatkhawale.github.io

# Port (optional, defaults to 3001)
PORT=3001

# Admin secret key for accessing /api/logs and /api/error-logs
ADMIN_KEY=your_secret_admin_key_here
